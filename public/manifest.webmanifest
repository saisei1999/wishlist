{
  "name": "Wishlist",
  "short_name": "Wishlist",
  "description": "A local-first wish list: capture a link, get a card, decide what to buy next.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#f8faf9",
  "theme_color": "#e8edee",
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "application/x-www-form-urlencoded",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "icons": [
    {
      "src": "icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ]
}
